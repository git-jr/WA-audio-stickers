{
  "manifest_version": 3,
  "name": "Figurinhas com som",
  "version": "0.7.2",
  "description": "Crie figurinhas com som a partir de um vídeo, uma imagem ou um GIF e envie pelo WhatsApp Web. Extensão não oficial.",
  "icons": {
    "16": "icons/icone-16.png",
    "32": "icons/icone-32.png",
    "48": "icons/icone-48.png",
    "128": "icons/icone-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Criar figurinha com som",
    "default_icon": {
      "16": "icons/icone-16.png",
      "32": "icons/icone-32.png"
    }
  },
  "options_page": "registro.html",
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/logger.js", "src/convert.js", "src/wa.js", "src/ui.js", "src/main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
